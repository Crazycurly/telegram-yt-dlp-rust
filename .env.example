# --- Required ---------------------------------------------------------------

# Bot token from @BotFather
BOT_TOKEN=123456:ABCDEF_replace_me

# Comma-separated allowlist of NUMERIC Telegram user IDs that may use the bot.
# Empty = nobody is allowed. Find your id via @userinfobot.
ALLOWED_USER_IDS=

# --- Local Bot API server (2 GB uploads) ------------------------------------
# Create these at https://my.telegram.org → "API development tools".
# Needed by the telegram-bot-api service in docker-compose.yml.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Base URL of the Bot API server. docker-compose sets this for you.
# Leave blank when running locally against Telegram's cloud API (50 MB cap).
# TELEGRAM_API_URL=http://telegram-bot-api:8081

# Max upload size in MB. 2000 with the local server; use 50 on the cloud API.
MAX_FILE_MB=2000

# --- Optional tuning ---------------------------------------------------------

# Working directory for downloads (a writable volume in Docker).
DOWNLOAD_DIR=/downloads

# How often (hours) to self-update yt-dlp in the background.
UPDATE_INTERVAL_HOURS=12

# Global cap on simultaneous downloads across all chats.
MAX_CONCURRENT_DOWNLOADS=3

# Log level: error | warn | info | debug | trace
RUST_LOG=info
